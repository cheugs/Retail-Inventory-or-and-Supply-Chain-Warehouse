# Copy this file to .env and change the values if needed.
# .env is ignored by Git: never commit real passwords.

# PostgreSQL (the warehouse). 5433 on the host to avoid clashing with a local PostgreSQL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=retail_dw
POSTGRES_USER=retail
POSTGRES_PASSWORD=change_me

# Airflow web interface login (local only)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Size of the simulated company
SIM_START_DATE=2026-01-01
SIM_DAYS=90
SIM_STORES=6
SIM_PRODUCTS=150
SIM_SUPPLIERS=12
SIM_SEED=42

# dbt target: postgres (default) or snowflake (optional, see docs/ARCHITECTURE.md)
DBT_TARGET=postgres
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_ROLE=TRANSFORMER
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=RETAIL_DW
